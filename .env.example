# Public site key (pk_...) from https://usevetto.com/app, free on one site.
# Enables the browser check: typo fixes, throwaway/dead-domain blocking, bot honeypot.
NEXT_PUBLIC_VETTO_SITE_KEY=

# Optional, Vetto Pro: secret key (sk_...). Server-side only, never expose it.
# With it, the Server Action verifies the signed vetto_token and falls back to /v1/check.
# Without it, the Server Action uses the free keyless /v1/audit domain lookup.
VETTO_SECRET_KEY=
